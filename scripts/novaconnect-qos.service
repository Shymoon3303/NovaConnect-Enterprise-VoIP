[Unit]
Description=NovaConnect VoIP QoS Traffic Prioritization
After=network.target
Requires=sys-subsystem-net-devices-enp0s8.device
After=sys-subsystem-net-devices-enp0s8.device
Before=asterisk.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/novaconnect-qos.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
